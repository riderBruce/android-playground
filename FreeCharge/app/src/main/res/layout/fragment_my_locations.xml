<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tvMyLocationsTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:text="My Outlet Locations"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddNewLocation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:text="Add new location"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvMyLocationsTitle" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMyLocations"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnAddNewLocation"
        tools:listitem="@android:layout/simple_list_item_2" />

    <TextView
        android:id="@+id/tvEmptyLocations"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="No locations yet.\nAdd your first charging location."
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/rvMyLocations"
        app:layout_constraintEnd_toEndOf="@id/rvMyLocations"
        app:layout_constraintStart_toStartOf="@id/rvMyLocations"
        app:layout_constraintTop_toTopOf="@id/rvMyLocations"
        tools:visibility="visible" />
</androidx.constraintlayout.widget.ConstraintLayout>

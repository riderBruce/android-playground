<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Profile"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnUpdateProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Update Profile" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgAvatar"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginEnd="16dp"
                android:contentDescription="Profile avatar"
                android:src="@drawable/biking" />

            <TextView
                android:id="@+id/tvName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Alex"
                android:textSize="16sp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="City"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Not set"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvPreferredActivityLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Preferred Activity"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPreferredActivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Biking"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Weekly Goal Minutes"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRunningWeeklyGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Running: 210 min/week"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvWalkingWeeklyGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Walking: 210 min/week"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvBikingWeeklyGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Biking: 210 min/week"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvSwimmingWeeklyGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Swimming: 210 min/week"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvStandUpWeeklyGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Stand-up: 210 min/week"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvDistanceUnitLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Distance Unit"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDistanceUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kilometers"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
